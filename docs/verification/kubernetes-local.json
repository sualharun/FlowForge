  "startupFinding": {
    "area": "Startup ordering",
    "detail": "Backend pods have no initContainers and no dependency ordering, so they start before postgres/kafka DNS resolves, fail fast with UnknownHostException, exit 1, and converge via restartPolicy: Always. Observed 2-3 restarts per backend pod before readiness; zero further restarts under load. Docker Compose orders this with depends_on: service_healthy; Kubernetes has no equivalent in these manifests.",
    "severity": "P2"
  }
