    {"name": "createShipment", "taskType": "DELAY", "payload": {"durationMs": 500}, "dependsOn": ["processPayment"]},
    {"name": "sendConfirmation", "taskType": "DATA_TRANSFORM", "payload": {"operation": "IDENTITY", "data": {"orderId": "order-1042", "message": "Order confirmed"}}, "dependsOn": ["createShipment"]}
