# Local development defaults; replace before exposing any service.
DB_PASSWORD=flowforge-local-only
API_PORT=8088
FRONTEND_PORT=3000
DB_PORT=5433
REDIS_PORT=6380
KAFKA_EXTERNAL_PORT=29092
PROMETHEUS_PORT=9090
FLOWFORGE_WORKER_CONCURRENCY=4
FLOWFORGE_GLOBAL_CONCURRENCY=32
# Optional per-task-type caps; empty disables them. Example: MOCK_PAYMENT:4,DELAY:16
FLOWFORGE_TASK_TYPE_CONCURRENCY=
WORKER_TIMEOUT_MS=15000
KAFKA_TOPIC_PARTITIONS=12
# Local Kafka is a single broker; raise this only against a multi-broker cluster.
KAFKA_TOPIC_REPLICAS=1
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError
